#!/bin/bash
# Generated by `mfwater -a mfda-jobscript` from jobscript_slurm.sh.template. Submit with `sbatch`.
#
# Number of tasks: chains x calc_cpus(N_1) (printed by `mfwater -a mfda-ncpu ...`). All tasks
# share one node (--nodes=1), because each chain starts its own `mpirun` from this allocation.
#
# RESTART: resubmit this very script (same --workdir and same run TOML).
# Finished chains are skipped, unfinished chains are replayed from the start with
# the same seed and every cached evaluation returns instantly. Arguments are
# compared with <workdir>/manifest.json; a mismatch of the settings aborts, a changed git hash only warns.
#
# SMOKE TEST (run once before a long job, one real evaluation, no MCMC):
#   mfwater -a mfda-smoke --forward-model md --molecules 32 --workdir ./smoke_run
#
@SBATCH_HEADER@

export OMP_NUM_THREADS=1
# Without a terminal Python buffers stdout, so the progress output (--print-level)
# would only reach the slurm log at the end of the job.
export PYTHONUNBUFFERED=1

@ENVIRONMENT_SETUP@

# The run TOML (-c) overrides command line options, so a `lammps_cmd` set there wins
# over the --lammps-cmd of the cluster profile.
"${MFWATER:-mfwater}" -a markov-chain -c @RUN_TOML@@LAMMPS_OPTION@
