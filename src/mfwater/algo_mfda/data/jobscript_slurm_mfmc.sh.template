#!/bin/bash
# Generated by `mfwater -a mfmc-jobscript` from jobscript_slurm_mfmc.sh.template. Submit with `sbatch`.
#
# Number of tasks: total_cpus of the run TOML. All tasks share one node (--nodes=1); the
# evaluation pool of `mfmc-run` packs MD evaluations onto these cores and starts one `mpirun`
# per evaluation from this allocation.
#
# RESTART: resubmit this very script (same workdir and same run TOML). Evaluations with a
# result are never repeated; interrupted evaluations resume from their LAMMPS restart files.
# The settings are compared with <workdir>/manifest.json; a mismatch aborts.
#
# SEVERAL JOBS ON ONE RUN: submit this script k times (`sbatch run.sh` k times). The jobs
# claim evaluations through files in <workdir>/cache and share the work. A job that has
# nothing left to claim, while others still compute, exits with a message (exit code 0). The
# job that finishes the last evaluation of a phase continues with the next one. A job that
# died leaves a claim that becomes stale after `claim_timeout` (default 1800 s); resubmit
# afterwards to take it over.
#
@SBATCH_HEADER@

export OMP_NUM_THREADS=1
# Without a terminal Python buffers stdout, so the progress output would only reach the
# slurm log at the end of the job.
export PYTHONUNBUFFERED=1

@ENVIRONMENT_SETUP@

# The run TOML (-c) overrides command line options, so a `lammps_cmd` set there wins
# over the --lammps-cmd of the cluster profile.
"${MFWATER:-mfwater}" -a mfmc-run -c @RUN_TOML@@LAMMPS_OPTION@
